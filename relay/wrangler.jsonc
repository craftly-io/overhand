{
  // The relay and hosted dashboard, one origin: app.overhand.dev. Static files are the dashboard build and never run the
  // Worker; only /relay/* and / do (/ signed out is a public page). Not deployed by CI: run `cd relay && bunx wrangler@4.151.1 deploy` after the one-time
  // setup in relay/README.md. Secrets (never in this file): SIGNING_KEY, WORKOS_API_KEY, TURN_KEY_API_TOKEN,
  // PADDLE_API_KEY, PADDLE_WEBHOOK_SECRET, and on staging GITHUB_APP_PRIVATE_KEY (hosted runs). app.overhand.dev is on live Paddle; `--env staging` is overhand-relay-staging on staging-app.overhand.dev: its own
  // database, signing key and secrets, always on Paddle sandbox, so relay changes are tried there before app.overhand.dev.
  // Workers are named overhand-<part>[-staging]: overhand-site, overhand-site-staging, overhand-get, overhand-relay.
  "name": "overhand-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "app.overhand.dev", "custom_domain": true }],
  "workers_dev": false,
  // wrangler dev on http://localhost:8790, one of APP_ORIGINS, so the dashboard there runs as the hosted page
  "dev": { "port": 8790 },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // a missing file is a real 404, never the app's page: answering 200 to any address (e.g. /js/raif_ch.js) is what a
    // phishing kit looks like to a payment provider's review; the app itself only lives at /
    "not_found_handling": "none",
    "run_worker_first": ["/relay/*", "/", "/robots.txt", "/.well-known/security.txt"]
  },
  "build": {
    "command": "cd .. && bun run --filter web build && rm -rf relay/public && cp -R apps/web/dist relay/public && printf '/*\\n  X-Frame-Options: DENY\\n  Referrer-Policy: same-origin\\n  X-Content-Type-Options: nosniff\\n  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), serial=(), browsing-topics=()\\n' > relay/public/_headers"
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "Workspace" },
      { "name": "TEAM", "class_name": "TeamRoom" }
    ]
  },
  // SQLite-backed: the only kind on the Free plan, and required for new namespaces since 2026-07-09. v2: teams' rooms;
  // v3: hosted runs' Runner (unbound until the owner's setup: README.md, Hosted runs)
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Workspace"] },
    { "tag": "v2", "new_sqlite_classes": ["TeamRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["Runner"] }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "overhand-relay", "database_id": "946dc716-089c-485a-8eea-e0beae896347" }],
  "vars": {
    "PADDLE_ENV": "production",
    "PADDLE_CLIENT_TOKEN": "live_70a4510ec0a19a77b127108aa32",
    "WORKOS_CLIENT_ID": "client_01M5CA0K6CGWM9BW9KNYBGDBRZ",
    "TURN_KEY_ID": "2e409ac1e866ed347824c037016b1803",
    "TURN_MONTHLY_GRANTS": "300",
    "SIGN_IN_PROVIDERS": "",
    "SITE_ORIGIN": "https://overhand.dev"
  },
  "env": {
    "staging": {
      "routes": [{ "pattern": "staging-app.overhand.dev", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "WORKSPACE", "class_name": "Workspace" },
          { "name": "TEAM", "class_name": "TeamRoom" }
          // hosted runs (relay/src/hosted.ts), once the owner's steps in README.md (Hosted runs) are done: uncomment
          // , { "name": "RUNNER", "class_name": "Runner" }
        ]
      },
      // hosted runs: one container per run, started and destroyed by its workspace's Runner. Uncomment with the binding
      // above and the vars below (a deploy then builds ./runner/Dockerfile, so it needs Docker)
      // "containers": [
      //   {
      //     "class_name": "Runner",
      //     "scheduling_policy": "durable_object",
      //     "images": { "base": { "dockerfile": "./runner/Dockerfile" } },
      //     "max_instances": 10
      //   }
      // ],
      "d1_databases": [
        { "binding": "DB", "database_name": "overhand-relay-staging", "database_id": "67c52b9a-25a4-4d27-8e7c-a9258da8329a" }
      ],
      "vars": {
        "PADDLE_ENV": "sandbox",
        "PADDLE_CLIENT_TOKEN": "test_c7dd6ab9b5bf1169568c3f0a844",
        "WORKOS_CLIENT_ID": "client_01M5CA0JNS4YVSP55E6JQKAVJZ",
        "TURN_KEY_ID": "9d1607ff7bb3a78d4528514cc365944e",
        "TURN_MONTHLY_GRANTS": "300",
        "SIGN_IN_PROVIDERS": "",
        "SITE_ORIGIN": "https://staging.overhand.dev"
        // hosted runs on, with the container above; GITHUB_APP_ID is the App's id (relay/runner/github-app.ts)
        // , "HOSTED_RUNS": "1", "HOSTED_RUN_MAX_MIN": "60", "GITHUB_APP_ID": "<the App's id>"
      }
    }
  }
}
