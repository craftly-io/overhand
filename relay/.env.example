# Every var and secret the relay Worker reads (Env in src/worker.ts). Placeholders only: never put a real value here.
# Vars go in wrangler.jsonc "vars"; secrets go in `bunx wrangler@4.151.1 secret put NAME`.
# For `wrangler dev`, copy what you need into relay/.dev.vars (gitignored). The bindings (DB, WORKSPACE, ASSETS) are
# set in wrangler.jsonc, not here.

# ── Paddle ──
# "sandbox" (default) or "production". Only the literal "production" reaches Paddle's live API.
PADDLE_ENV=sandbox
# Paddle.js client-side token, public by design. Sandbox tokens start with test_, live tokens with live_.
PADDLE_CLIENT_TOKEN=test_replace_me
# Secret. Server-side API key: prices read, transactions write, customers/portal and subscriptions write.
PADDLE_API_KEY=replace_me
# Secret. The notification destination's secret key, for verifying Paddle-Signature on webhooks.
PADDLE_WEBHOOK_SECRET=replace_me

# ── WorkOS AuthKit sign-in ──
# The environment's client ID (a var).
WORKOS_CLIENT_ID=client_replace_me
# Secret. The environment's API key.
WORKOS_API_KEY=replace_me
# The OAuth providers the sign-in page shows, by WorkOS name, comma-separated (a var). Empty: email and passkey only.
# List one only once it's configured and turned on in WorkOS.
SIGN_IN_PROVIDERS=GitHubOAuth,GoogleOAuth

# ── Cloudflare Realtime TURN ──
# The TURN key's ID (a var).
TURN_KEY_ID=replace_me
# Secret. The TURN key's API token.
TURN_KEY_API_TOKEN=replace_me
# TURN credential grants per workspace per month before /relay/ice hands out STUN only (a var; 300 when unset).
TURN_MONTHLY_GRANTS=300

# ── The relay itself ──
# Secret. Ed25519 PKCS#8, base64url, from `bun relay/keygen.ts`: signs sessions, link certificates and entitlement tokens.
SIGNING_KEY=replace_me
# The public site, allowed to read /relay/prices (CORS).
SITE_ORIGIN=https://www.example.com
# "1" enables /relay/dev-login on localhost only. Local development only: leave unset everywhere else.
DEV_LOGIN=

# ── Hosted runs (relay/src/hosted.ts), staging only until they go live ──
# "1" switches hosted runs on (a var). Unset: every /relay/hosted/ route answers 404 and billing shows no run minutes.
HOSTED_RUNS=
# The longest one hosted run may take, in minutes (a var; 60 when unset). Each run reserves this much before it starts.
HOSTED_RUN_MAX_MIN=60
# Overhand's GitHub App id (a var), from relay/runner/github-app.ts.
GITHUB_APP_ID=
# Secret. The App's private key as PKCS#8 PEM (openssl pkcs8 -topk8 -nocrypt converts GitHub's download).
GITHUB_APP_PRIVATE_KEY=replace_me
