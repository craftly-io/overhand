{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "*.ts",
    "release/*.ts",
    "relay/**/*.ts",
    "site/*.ts",
    "site/get/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/plugins/**/*.ts",
    "packages/*/test/**/*.ts"
  ]
}
